# Cloned target repositories, runtime state, generated output
/git/
/.state/
/reports/
/RELEASE_NOTES.md
test-results/
coverage/
node_modules/
.tox/

# Local configuration and overrides; only config/example/ is tracked
/config/config.json
/config/local.json
/config/*.local.*
/config/dev.yaml
/config/*/
!/config/example/

# Credentials and local scratch (also enforced by scripts/check-secrets.py)
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
.git-credentials
auth.json

# Tool-generated
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock
.workshop.lock
package-lock.json

# Build artifacts
dist/
build/
*.exe
*.dll
*.so
*.dylib
*.snap

# Editor and OS noise
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.tmp
*.log
